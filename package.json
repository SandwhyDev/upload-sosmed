{
  "name": "ruang-konten",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker.ts",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "db:push": "prisma db push",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/backend.integration.ts",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.0.0",
    "ffprobe-static": "^3.1.0",
    "file-type": "^21.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pg": "^8.16.0",
    "pg-boss": "12.38.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
