# npm run dev starts a persistent local PostgreSQL automatically when DATABASE_URL is absent.
# For Docker or an existing PostgreSQL, set DATABASE_URL instead.
# DATABASE_URL=postgresql://ruang:change-this@127.0.0.1:5432/ruang_konten
APP_ORIGIN=http://127.0.0.1:3000
# Secret reverse proxy opsional untuk APP_ORIGIN HTTPS (openssl rand -hex 32).
# RUANG_PROXY_SECRET=
META_API_VERSION=v27.0
# Instagram API with Unified Login (Meta for Developers).
# Register this exact callback URL in the Instagram Unified Login configuration.
# INSTAGRAM_REDIRECT_URI=https://domain-anda.example/instagram-callback.html
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_CONFIG_ID=
LINKEDIN_API_VERSION=202610
# Instagram media storage: configure Cloudinary OR R2. Cloudinary takes priority when both are configured.
# Keep these credentials server-side; never use NEXT_PUBLIC_ variables.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional R2 alternative:
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
